# Core server configuration
DATABASE_URL=
# Test-only PostgreSQL database. Never point this at production.
TEST_DATABASE_URL=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://www.ereteam.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public website and AI assistant
GROQ_API_KEY=
SITE_CHAT_MODEL=openai/gpt-oss-20b
RESEND_API_KEY=
REVALIDATE_SECRET=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Only needed by one-off Sanity maintenance/migration scripts.
SANITY_API_WRITE_TOKEN=

# Presales bootstrap login (used only while AdminCredential table is empty)
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=

# Presales Google Drive and notifications
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
PRESALES_NOTIFICATION_EMAIL=

# Spark revenue dashboard and HubSpot
SPARK_PASSWORD=
HUBSPOT_ACCESS_TOKEN=
SPARK_LICENSE_TARGET_2026=
SPARK_SERVICE_TARGET_2026=
SPARK_LICENSE_TARGET_2027=
SPARK_SERVICE_TARGET_2027=
CRON_SECRET=
AMPLEMARKET_WEBHOOK_SECRET=

# Optional website feeds
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
SORO_RSS_URL=

# Optional diagnostics and legacy compatibility
SPARK_CHAT_DEBUG=0
SPARK_CRON_SECRET=
